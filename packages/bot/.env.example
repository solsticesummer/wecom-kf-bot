# WeCom (企业微信) — all from the admin console at work.weixin.qq.com
# 我的企业 → 企业信息 → 企业ID
CORP_ID=ww1234567890abcdef
# 微信客服 → API → Secret (企业内部开发凭据)
KF_SECRET=your-kf-secret
# 微信客服 → API → 接收消息设置 → Token (you generate this; must match the console)
WECOM_TOKEN=your-random-token
# Same screen → EncodingAESKey (43 chars; you generate this; must match the console)
WECOM_AES_KEY=your-43-char-encoding-aes-key-goes-here-xx

# Aliyun 百炼 (DashScope) — from bailian.console.aliyun.com → API-KEY
DASHSCOPE_API_KEY=sk-...

# NOTE: the model id, sampling temperature and every customer-facing string now live in
# tenants/<id>.yaml, NOT here. Env is for infrastructure that is identical for every
# tenant (keys, endpoints, DATABASE_URL); anything tenant-scoped moved to the tenant file,
# because one global env var cannot mean two things once a second tenant exists.
# The server serves EVERY tenants/*.yaml at once, routing each message to the tenant that
# owns its kf account (see `wecom.kf_ids` in the tenant file) — there is no "which tenant is
# this process" setting. These two are the exceptions:
#   TENANT_ID          — dev scripts only (npm run chat / demo): which tenant to talk to.
#   DEFAULT_TENANT_ID  — which tenant the legacy un-prefixed /bugs, /unanswered, /usage
#                        report on. Prefer the explicit /t/<tenant>/... routes.
# TENANT_ID=dramaclaw
# DEFAULT_TENANT_ID=dramaclaw

# Admin-surface tokens. /bugs and /unanswered contain verbatim CUSTOMER MESSAGES, so the
# whole surface is fail-closed: with nothing set here, every admin route returns 403.
#
#   ADMIN_TOKEN            — operator-wide. Reads every tenant, and is the only thing that
#                            can GET /tenants. A single-tenant deployment needs only this.
#   ADMIN_TOKEN_<TENANT>   — reads ONE tenant (id upper-cased, non-alphanumerics -> _), so
#                            one product's operator can't read another's customers.
#
# Prefer `Authorization: Bearer <token>` over `?token=` — query strings end up in access
# logs, proxy logs, referrers and browser history. Both are accepted.
# ADMIN_TOKEN=pick-a-long-random-string
# ADMIN_TOKEN_DRAMACLAW=a-different-long-random-string

# Optional: per-customer rate limit (protects Qwen tokens from a spammer).
# Defaults: 15 messages per 60s per customer, then a one-time "slow down" notice.
# The notice TEXT is tenant copy (tenants/<id>.yaml); only the thresholds are env.
# RATE_LIMIT_MAX=15
# RATE_LIMIT_WINDOW_SECONDS=60

# NOT the safety mechanism any more. What keeps the bot away from the live 官方客服 is the
# tenant registry: the 微信客服 callback is enterprise-wide, and a kf account that no
# tenants/*.yaml claims in `wecom.kf_ids` has no tenant to answer as, so its messages are
# dropped. That is fail-closed by construction rather than by remembering an env var.
#
# This remains only as EXTRA narrowing for a staged rollout: when set, only these accounts
# are served even if a tenant claims more. Leave it unset in normal operation.
# Find open_kfids with:  npm run list-kf
# ALLOWED_KF_IDS=wkxxxxxxTESTxxxxxx

# --- Test-only overrides. NEVER set these in production. ---
# WECOM_API_BASE   — point the WeCom client at a fake upstream so the pipeline tests can
#                    assert on what the bot tried to send.
# TENANTS_DIR      — load tenants from somewhere other than packages/bot/tenants, so tests
#                    can use fixture tenants that own kf accounts.
# WECOM_API_BASE=http://127.0.0.1:9999/cgi-bin
# TENANTS_DIR=./test/fixtures/tenants

# --- Retrieval (Phase 1: hybrid vector + trigram + rerank) ---
# Postgres (with pgvector + pg_trgm). Local dev: postgres://<you>@localhost:5432/wecom
DATABASE_URL=postgres://user:pass@localhost:5432/wecom
# Embeddings + rerank are Model Studio (百炼) services and need a STANDARD DashScope
# key (sk-...) — NOT a Coding-Plan (sk-sp-...) key. If empty, generateReply() falls
# back to inlining the full FAQ.
MODELSTUDIO_API_KEY=sk-...
# EMBEDDING_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/embeddings
# EMBEDDING_MODEL=text-embedding-v4
# EMBEDDING_DIM=1024
# RERANK_API_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
# RERANK_MODEL=qwen3-rerank
# RETRIEVAL_TOP_K=5
# RETRIEVAL_CANDIDATES=20
# Near-duplicate suppression: two retrieved chunks with cosine >= this are treated as
# duplicates and the lower-ranked one is dropped (keeps top-k diverse). 0.92 keeps
# complementary same-topic chunks; lower it to be more aggressive.
# RETRIEVAL_DEDUP_SIM=0.92
# Where build-index.js finds the manual (.pdf) + whitepaper (.pptx) source docs
# KB_SOURCE_DIR=./knowledge/sources
# Which namespace `npm run index` writes into. Reads come from the tenant's `namespace`,
# so leave this alone unless you are indexing a corpus for a different tenant.
# KB_NAMESPACE=dramaclaw

# Optional overrides
# DATA_DIR=./data
# PORT=3000
