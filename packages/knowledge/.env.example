# Postgres for the knowledge store. Use a DEDICATED database so the dev tool
# never shares the live bot's data. (pgvector + pg_trgm are created automatically.)
KNOWLEDGE_DATABASE_URL=postgresql:///knowledge_dev

# DashScope embeddings need the STANDARD (sk-ws) Model Studio key.
# MODELSTUDIO_API_KEY is preferred; DASHSCOPE_API_KEY is the fallback.
MODELSTUDIO_API_KEY=sk-xxxxxxxx

# Optional overrides (defaults shown):
# EMBEDDING_MODEL=text-embedding-v4
# EMBEDDING_DIM=1024
# KNOWLEDGE_EMBEDDER=dashscope   # set to "fake" for offline (non-semantic) tests
# KNOWLEDGE_RERANK=auto          # auto = on when a real embedder + key exist; "off" to skip
# RERANK_MODEL=qwen3-rerank

# --- HTTP transport (knowledge-mcp --http), for hosted/remote consumers ---
# BOTH are required in HTTP mode; the server refuses to start without them. kb_ingest reads
# a server-side path and makes it searchable, so unauthenticated + unconfined it is a way to
# read files off this host (ingest ~/.ssh, then kb_search it back).
# KNOWLEDGE_HTTP_TOKEN=generate-with-openssl-rand-hex-32
# KNOWLEDGE_INGEST_ROOT=/srv/corpora
# KNOWLEDGE_HTTP_HOST=127.0.0.1   # anything else warns: the token travels in plaintext
# KNOWLEDGE_HTTP_PORT=8765
